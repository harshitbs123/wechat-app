<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Chat</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="icon" type="image/png" href="/icon.png" />
  </head>
  <body>
    <div
      class="p-4 bg-gray-100 border-2 border-black rounded-lg shadow-md mt-7 w-[30%] mx-auto flex flex-col"
    >
      <form action="/chats/<%=chat._id%>?_method=PATCH" method="POST">
        <div class="">
          <h1 class="text-lg font-semibold mb-2">From : <%= chat.from %></h1>
          <textarea
            class="font-light text-lg text-white bg-blue-300 placeholder:text-white rounded-xl w-full p-4"
            rows="10"
            name="msg"
            placeholder="Enter message here ->"
          >
 <%= chat.msg %>...</textarea>
          <h1 class="text-lg font-semibold">Received By : <%= chat.to %></h1>
        </div>
        <div class="flex justify-center mt-3">
          <button
            class="border px-10 text-lg rounded-lg font-medium hover:bg-gray-400 hover:text-white transition cursor-pointer hover:font-light duration-300"
          >
            EDIT
          </button>
        </div>
      </form>
      <div class="flex justify-center mt-2">
        <form action="/chats/<%=chat._id%>?_method=DELETE" method="POST">
          <button
            class="border px-10 mx-4 text-lg rounded-lg font-medium hover:bg-gray-400 hover:text-white transition cursor-pointer hover:font-light duration-300"
          >
            DELETE
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
